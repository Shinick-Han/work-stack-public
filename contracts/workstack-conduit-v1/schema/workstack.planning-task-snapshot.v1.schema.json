{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workstack-conduit:workstack.planning-task-snapshot.v1",
  "title": "Work Stack planning task snapshot v1",
  "description": "Structural aid only. The frozen contract, canonical-byte rules, Unicode 17.0.0 NFC rule, cross-field origin derivation, dual scalar/UTF-16 limits, safety policy, and digest verification remain normative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detail",
    "due_date",
    "format",
    "legacy_task_id",
    "origin_ref",
    "planning_priority",
    "planning_status",
    "planning_task_uid",
    "revision",
    "title",
    "workspace_uid"
  ],
  "properties": {
    "detail": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F]*$"
    },
    "due_date": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      ]
    },
    "format": {
      "const": "workstack.planning-task-snapshot.v1"
    },
    "legacy_task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{4,}$"
    },
    "origin_ref": {
      "type": "string",
      "pattern": "^workstack://[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/planning-tasks/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "planning_priority": {
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "planning_status": {
      "enum": ["open", "started", "done", "dropped"]
    },
    "planning_task_uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"
    },
    "workspace_uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
