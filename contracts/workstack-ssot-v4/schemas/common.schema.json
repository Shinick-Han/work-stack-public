{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workstack.local/contracts/workstack-ssot-v4/schemas/common.schema.json",
  "title": "Work Stack SSOT v4 common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateOrNull": {
      "oneOf": [
        { "$ref": "#/$defs/date" },
        { "type": "null" }
      ]
    },
    "dateOrTimestamp": {
      "oneOf": [
        { "$ref": "#/$defs/date" },
        { "$ref": "#/$defs/timestamp" }
      ]
    },
    "dateOrTimestampOrNull": {
      "oneOf": [
        { "$ref": "#/$defs/date" },
        { "$ref": "#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "uuidOrNull": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundedString": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F]*$"
    },
    "canonicalJsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalJsonValue" }
        },
        { "$ref": "#/$defs/canonicalJsonObject" }
      ]
    },
    "canonicalJsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/canonicalJsonValue" }
    },
    "recordEnvelope": {
      "type": "object",
      "required": [
        "format",
        "schema_version",
        "workspace_uid",
        "uid",
        "revision",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "format": { "type": "string" },
        "schema_version": { "type": "integer", "minimum": 1 },
        "workspace_uid": { "$ref": "#/$defs/uuid" },
        "uid": { "$ref": "#/$defs/uuid" },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": { "$ref": "#/$defs/dateOrTimestampOrNull" },
        "updated_at": { "$ref": "#/$defs/dateOrTimestampOrNull" }
      }
    },
    "eventEnvelope": {
      "type": "object",
      "required": [
        "format",
        "schema_version",
        "workspace_uid",
        "event_uid",
        "sequence",
        "record_uid",
        "created_at",
        "actor",
        "provenance"
      ],
      "properties": {
        "format": { "type": "string" },
        "schema_version": { "type": "integer", "minimum": 1 },
        "workspace_uid": { "$ref": "#/$defs/uuid" },
        "event_uid": { "$ref": "#/$defs/uuid" },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "record_uid": { "$ref": "#/$defs/uuidOrNull" },
        "created_at": { "$ref": "#/$defs/dateOrTimestamp" },
        "actor": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "provenance": { "type": "string", "minLength": 1, "maxLength": 128 },
        "previous_event_digest": { "$ref": "#/$defs/sha256" },
        "event_digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
