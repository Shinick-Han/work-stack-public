{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workstack.local/contracts/workstack-ssot-v4/schemas/reply.schema.json",
  "title": "Work Stack SSOT v4 reply record",
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "connection_ref", "container_ref", "object_ref", "version_ref"],
      "properties": {
        "resource_type": { "type": "string", "minLength": 1, "maxLength": 160 },
        "connection_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
        "container_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
        "object_ref": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "version_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
        "display_title": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "reply_display_id", "provider", "outcome", "occurred_at", "body_digest", "target_digest"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "reply_display_id": { "type": "string", "pattern": "^R-[0-9]{4,}$" },
        "provider": { "enum": ["microsoft-outlook", "microsoft-teams"] },
        "outcome": { "enum": ["sent", "failed", "unknown"] },
        "occurred_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "body_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "target_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "remote_message_ref": { "type": ["string", "null"], "maxLength": 1000 },
        "web_url": {
          "oneOf": [
            { "type": "string", "format": "uri", "maxLength": 4096 },
            { "type": "null" }
          ]
        },
        "error_code": { "type": ["string", "null"], "maxLength": 160 }
      }
    }
  },
  "allOf": [
    { "$ref": "common.schema.json#/$defs/recordEnvelope" },
    {
      "type": "object",
      "required": ["display_id", "task_uid", "capture_uid", "capture_revision", "provider", "capability", "target", "body", "body_digest", "target_digest", "state", "approved_at", "receipt"],
      "properties": {
        "format": { "const": "workstack.reply" },
        "schema_version": { "const": 1 },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "display_id": { "type": "string", "pattern": "^R-[0-9]{4,}$" },
        "task_uid": { "$ref": "common.schema.json#/$defs/uuid" },
        "capture_uid": { "$ref": "common.schema.json#/$defs/uuid" },
        "capture_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "provider": { "enum": ["microsoft-outlook", "microsoft-teams"] },
        "capability": { "enum": ["outlook.reply", "teams.reply"] },
        "target": { "$ref": "#/$defs/target" },
        "body": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "body_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "target_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "state": { "enum": ["approved", "sent", "failed", "unknown"] },
        "approved_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "receipt": {
          "oneOf": [
            { "$ref": "#/$defs/receipt" },
            { "type": "null" }
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
