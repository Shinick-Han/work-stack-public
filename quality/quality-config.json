  "architecture_exceptions": [
    {
      "from": "frontend/src/features/integrations/MicrosoftOobDialog.tsx",
      "to": "frontend/src/features/inbox/CaptureImportDialog.tsx",
      "rationale": "The read-only Microsoft handoff composes the established sanitized packet review dialog until the shared capture-review contract is extracted.",
      "expires": "2026-12-31"
    },
    {
      "from": "frontend/src/features/workspace/WorkspacePage.tsx",
      "to": "frontend/src/features/focus/useLocalToday.ts",
      "rationale": "Workspace reuses the tested local-midnight clock until the neutral calendar hook is extracted.",
      "expires": "2026-12-31"
    },
    {
      "from": "frontend/src/features/workspace/views/BoardView.tsx",
      "to": "frontend/src/features/focus/useLocalToday.ts",
      "rationale": "The board uses the tested local-midnight clock until the neutral calendar hook is extracted.",
      "expires": "2026-12-31"
    },
    {
      "from": "frontend/src/features/workspace/views/TableView.tsx",
      "to": "frontend/src/features/focus/useLocalToday.ts",
      "rationale": "The table uses the tested local-midnight clock until the neutral calendar hook is extracted.",
      "expires": "2026-12-31"
    },
    {
      "from": "frontend/src/features/workspace/views/TaskDueTiming.tsx",
      "to": "frontend/src/features/focus/focusModel.ts",
      "rationale": "The due-date label reuses the deterministic Focus civil-date projection until calendar projection is neutralized.",
      "expires": "2026-12-31"
    },
    {
      "from": "frontend/src/features/workspace/views/viewModels.ts",
      "to": "frontend/src/features/focus/focusModel.ts",
      "rationale": "Workspace view projection reuses deterministic Focus civil-date semantics until calendar projection is neutralized.",
      "expires": "2026-12-31"
    }
  ]
