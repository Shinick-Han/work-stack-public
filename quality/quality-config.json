{
  "schema_version": 1,
  "source_sets": [
    {
      "name": "python_core",
      "roots": [
        "workstack"
      ],
      "extensions": [
        ".py"
      ],
      "exclude_globs": []
    },
    {
      "name": "python_entrypoint",
      "roots": [
        "run_work_stack.py"
      ],
      "extensions": [
        ".py"
      ],
      "exclude_globs": []
    },
    {
      "name": "python_desktop",
      "roots": [
        "desktop/python-webview-shell"
      ],
      "extensions": [
        ".py"
      ],
      "exclude_globs": []
    },
    {
      "name": "quality_tooling",
      "roots": [
        "scripts/check_coverage.py",
        "scripts/quality_gate.py",
        "scripts/release_gate.py",
        "scripts/run_ssh_regression.py",
        "scripts/run_mutation_sentinels.py"
      ],
      "extensions": [
        ".py"
      ],
      "exclude_globs": []
    },
    {
      "name": "frontend_production",
      "roots": [
        "frontend/src"
      ],
      "extensions": [
        ".ts",
        ".tsx"
      ],
      "exclude_globs": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "frontend/src/test/**",
        "**/*.d.ts"
      ]
    }
  ],
  "config_inputs": [
    ".github/workflows/ci.yml",
    ".github/workflows/quality-reusable.yml",
    ".github/workflows/release.yml",
    ".coveragerc",
    "frontend/package-lock.json",
    "frontend/package.json",
    "frontend/eslint.config.js",
    "frontend/vite.config.ts",
    "quality/coverage-floors.json",
    "quality/quality-config.json",
    "quality/release-path-policy.json",
    "requirements-dev.txt",
    "requirements.txt",
    "scripts/check_coverage.py",
    "scripts/quality_gate.py",
    "scripts/release_gate.py",
    "scripts/run_ssh_regression.py",
    "scripts/run_mutation_sentinels.py",
    "scripts/windows/Test-WorkStackReleaseBundle.ps1"
  ],
  "frontend_complexity": {
    "command": [
      "npm",
      "--prefix",
      "frontend",
      "run",
      "--silent",
      "lint:complexity"
    ],
    "critical_globs": [
      "frontend/src/api/**",
      "frontend/src/app/**",
      "frontend/src/features/inbox/**",
      "frontend/src/features/integrations/**",
      "frontend/src/features/tasks/**",
      "frontend/src/integration/**"
    ]
  },
  "critical_python_globs": [
    "workstack/capture.py",
    "workstack/planning_status.py",
    "workstack/service.py",
    "workstack/snapshot*.py",
    "workstack/storage/**",
